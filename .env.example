# Local, single-user development. Copy to .env at repository root.
# Docker Compose overrides database, Redis and job mode inside containers.
DATABASE_URL=sqlite:///./data/repopilot.db
DATA_DIR=./data
JOB_BACKEND=local
REDIS_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Zero-key offline mode: feature-hash vectors and extractive grounded answers.
# Switch both providers to openai to use the configured external API.
LLM_PROVIDER=extractive
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
# Optional generation pricing (USD per million tokens). Leave unset if unknown.
# LLM_INPUT_COST_PER_MILLION=
# LLM_OUTPUT_COST_PER_MILLION=
QUERY_CACHE_TTL=120

# Optional shared API bearer token. Compose passes it to the Next server proxy.
# Local frontend: set matching SERVER_API_AUTH_TOKEN in frontend/.env.local.
# This does not provide end-user authentication or tenant authorization.
API_AUTH_TOKEN=

# Docker execution is opt-in. Build the sandbox image before enabling.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=repopilot-sandbox:local
# npm commands use this separate image. Preinstall project test dependencies
# in a custom image before use; runtime downloads and image pulls are disabled.
SANDBOX_NODE_IMAGE=node:22-alpine
SANDBOX_TIMEOUT=45
AGENT_MAX_STEPS=12

# Development database credentials only; do not reuse in a public deployment.
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=repopilot-local-password
POSTGRES_DB=repopilot
